venv/
.venv/

# Node Dependencies & Build Outputs
**/node_modules/
frontend/dist/

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]

# Environment Variables (Keep example file)
.env
.env.*
!.env.example

# Local SQLite & Databases
data/*.sqlite
data/*.sqlite3
